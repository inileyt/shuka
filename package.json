{
  "name": "shuka",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shuka — Amazon-style marketplace for local use (Armenia, AMD, cash on delivery)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "migrate": "node server/src/migrate.js",
    "seed": "node server/src/seed.js",
    "backup": "node server/src/backup.js",
    "start": "node server/src/index.js",
    "local": "npm run build && npm run migrate && npm run seed && npm start",
    "test:break": "node server/scripts/break-tests.js"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-armenian": "^5.3.0",
    "@twemoji/svg": "^15.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
